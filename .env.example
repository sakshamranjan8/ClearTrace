# ==============================================================================
# ClearTrace Module 3 — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ==============================================================================

# --- Groq LLM Configuration ---
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Model to use (free tier options):
#   gemma2-9b-it          (recommended — best balance of speed + quality)
#   llama-3.3-70b-versatile  (slower, higher quality)
#   mixtral-8x7b-32768       (alternative)
GROQ_MODEL=gemma2-9b-it

# --- Teammate API URLs ---
# Set MOCK_MODE=true while teammates haven't deployed yet.
# When they deploy, set MOCK_MODE=false and fill in the URLs below.
MOCK_MODE=true

# Module 2: AQI Forecasting Service
MODULE2_FORECAST_URL=http://localhost:8001/forecast

# Module 4: Crowd Reports Service
MODULE4_REPORTS_URL=http://localhost:8002/reports

# --- Embedding Model (for FAISS vector store) ---
# This model runs locally — no API key needed.
# all-MiniLM-L6-v2 is 80MB, fast, and accurate enough for RAG.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Logging ---
LOG_LEVEL=INFO
